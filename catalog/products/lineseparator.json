{
  "id": "lineseparator",
  "name": "LineSeparator Skin",
  "summary": "Frekvensseparation til hud: jævnere hud uden plastik-look.",
  "homepage": "https://github.com/Line21DK/seperator",
  "targets": [
    {
      "id": "lineseparator-ofx-macos",
