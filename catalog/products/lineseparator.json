      "kind": "plugin-bundle",
      "platform": "macos",
      "host": "davinci-resolve",
      "install": {
        "path": "/Library/OFX/Plugins/Seperator.ofx.bundle",
        "bundleId": "dk.line21.seperator"
      },
      "releases": [
        {
          "version": "0.3.0",
          "channel": "stable",
          "date": "2026-11-12",
          "notes": "- AI-personmaske med Apple Vision (Person (AI) under Mask Source)\n- Hele pipelinen kører på GPU'en med Metal\n- Universal bundle (Apple Silicon og Intel)",
          "requires": { "macos": "11.0" },
          "artifacts": []
        }
      ]
    }
  ]
}
